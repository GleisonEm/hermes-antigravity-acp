+# ── Kernel progress feed (Antigravity stderr telemetry) ─────────────────
+# The kernel logs its internal WS activity to stderr as
+# ``RAW WS MSG: {"<eventType>": {...}}`` — tool calls, step/usage updates,
+# policy gates. Same information the `agy` CLI TUI renders. We parse it
+# into a per-session progress dict; the Hermes wait loop reads it to show
+# live status instead of a generic "no response yet" notice.
+#
+# Robustness contract: the parser must NEVER raise and never crash the
+# request. Unknown event types / changed formats just bump the activity
+# timestamp (kernel is alive) and are otherwise ignored — worst case the
+# feed degrades to the pre-feature behavior.
+
+# Progress snapshots keyed by the *worker thread* ident running
+# chat.completions.create — the Hermes wait loop polls
+# get_acp_thread_progress(t.ident) and reads this exact dict (mutated by
+# the kernel's stderr reader thread; dict field writes are atomic enough).
+_ACP_THREAD_PROGRESS: dict[int, dict[str, Any]] = {}
+_ACP_THREAD_PROGRESS_LOCK = threading.Lock()
+
+
+def _set_thread_progress(progress: dict[str, Any] | None) -> None:
+    tid = threading.get_ident()
+    with _ACP_THREAD_PROGRESS_LOCK:
+        if progress is None:
+            _ACP_THREAD_PROGRESS.pop(tid, None)
+        else:
+            _ACP_THREAD_PROGRESS[tid] = progress
+
+
+def get_acp_thread_progress(thread_ident: int | None) -> dict[str, Any] | None:
+    """Progress dict for the given worker thread ident (or None)."""
+    if thread_ident is None:
+        return None
+    with _ACP_THREAD_PROGRESS_LOCK:
+        return _ACP_THREAD_PROGRESS.get(thread_ident)
+
+
+def _new_kernel_progress() -> dict[str, Any]:
+    return {
+        "last_event_ts": None,      # monotonic ts of ANY parseable kernel event
+        "last_desc": "",            # human-readable last activity
+        "last_desc_ts": None,       # monotonic ts of last_desc
+        "tools": 0,                 # toolCall events seen
+        "steps": 0,                 # stepUpdate events seen
+        # Token accounting (cumulative session values from usageUpdate —
+        # the kernel reports session totals; per-prompt deltas are computed
+        # by the prompt paths into "usage_delta").
+        "usage": {"prompt": 0, "completion": 0, "cached": 0},
+        "usage_delta": {"prompt": 0, "completion": 0, "cached": 0},
+    }
