+def cancel_acp_keep_alive_sessions(reason: str = "interrupt") -> int:
+    """Signal every live/booting keep-alive session to abort its wait loop.
+
+    Called from the interrupt path (chat_completion_helpers). The owning
+    thread sees cancel_event within ~0.1s (inbox poll quantum), aborts, and
+    evicts the session — so a stop actually stops, instead of the abandoned
+    thread holding sess.lock until the prompt deadline.
+    Returns the number of sessions signalled.
+    """
+    with _KEEP_ALIVE_REGISTRY_LOCK:
+        sessions = list(_KEEP_ALIVE_REGISTRY.values()) + list(_KEEP_ALIVE_BOOTING.values())
+    count = 0
+    for sess in sessions:
+        try:
+            evt = getattr(sess, "cancel_event", None)
+            if evt is not None and not evt.is_set():
+                evt.set()
+                count += 1
+        except Exception:
+            pass
+    if count:
+        logger.info("ACP keep-alive: cancel signalled to %d session(s) (%s)", count, reason)
+    return count
+
