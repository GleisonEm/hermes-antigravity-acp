+# Boot budget for a fresh kernel (initialize + session/new + set_config).
+# Deliberately much shorter than the prompt deadline: a Google-side stall
+# during boot must fail fast with diagnostics, not wedge the session for
+# the full prompt timeout (stall 21:24 03/09/2026 — session badea4).
+_BOOT_TIMEOUT_SECONDS = 60.0
+
+# Double-checked boot coordination: key -> event signalled when the in-flight
+# boot finishes (success or failure). Lets concurrent turns wait on the boot
+# WITHOUT holding _KEEP_ALIVE_REGISTRY_LOCK across the multi-second spawn.
+_KEEP_ALIVE_BOOT_EVENTS: dict[str, threading.Event] = {}
+
+# Sessions currently inside _create_persistent_session (bootstrapping, not yet
+# in the registry). Registered so cancel_acp_keep_alive_sessions() can abort
+# a boot in flight instead of leaving it to run to the deadline.
+_KEEP_ALIVE_BOOTING: dict[str, Any] = {}
