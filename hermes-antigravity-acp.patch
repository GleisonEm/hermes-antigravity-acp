+
+    effective_base = creds.get("base_url") or effective_base
+
+    model_list = list(_PROVIDER_MODELS.get("antigravity-acp", ["antigravity-acp"]))
+    if model_list:
+        selected = _prompt_model_selection(
+            model_list,
+            current_model=current_model or model_list[0],
+            confirm_provider=provider_id,
+            confirm_base_url=effective_base,
+        )
+    else:
+        try:
+            selected = input("Model name: ").strip()
+        except (KeyboardInterrupt, EOFError):
+            selected = None
+
+    if not selected:
+        print("No change.")
+        return
+
+    _save_model_choice(selected)
+
+    # Prompt for ACP session mode (Zed parity: default/auto_edit/yolo). This
+    # controls whether the kernel asks permission before edits/commands.
+    # Stored as model.acp_mode; the ACP client reads it (or
+    # HERMES_ANTIGRAVITY_ACP_MODE env) and sends session/set_config_option.
+    try:
+        current_mode = ""
+        try:
+            _cfg_tmp = load_config()
+            _m = _cfg_tmp.get("model") or {}
+            if isinstance(_m, dict):
+                current_mode = str(_m.get("acp_mode") or "").strip().lower()
+        except Exception:
+            pass
+        if current_mode not in {"default", "auto_edit", "yolo"}:
+            current_mode = "yolo" if not current_mode else current_mode
+        print()
+        print(f"  Current Antigravity mode: {current_mode or 'default'}")
+        print("  Modes: default (ask before every edit), auto_edit (auto edits, ask for commands), yolo (auto everything).")
+        try:
+            raw = input(f"  Antigravity mode [{current_mode}] (default/auto_edit/yolo, Enter to keep): ").strip().lower()
+        except (KeyboardInterrupt, EOFError):
+            raw = ""
+        chosen_mode = raw if raw in {"default", "auto_edit", "yolo"} else current_mode
+        if chosen_mode not in {"default", "auto_edit", "yolo"}:
+            chosen_mode = "default"
+    except Exception:
+        chosen_mode = None
+
+    # Prompt for the ACP context pack (attach memory + domain skills to the
+    # kernel prompt). auto = memory + top-5 relevant skills; off = transcript
+    # only. Stored as model.acp_context_pack; the ACP client reads it.
+    try:
+        current_pack = ""
+        try:
+            _cfg_tmp = load_config()
