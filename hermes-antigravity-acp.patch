index 0000000000..9f9fca05c0
--- /dev/null
+++ b/agent/acp_context_pack.py
@@ -0,0 +1,334 @@
+"""ACP context pack — dá ao kernel Antigravity o contexto que o Hermes tem.
+
+O kernel ACP só recebe o transcript da conversa; ele não conhece a memória
+do usuário (MEMORY.md/USER.md), nem as skills curadas de domínio (SimPay,
+Uniplus, k8s, ...). Provedores nativos resolvem isso com system prompt
+estruturado + memória prefetch + índice de skills com skill_view sob
+demanda; o kernel não tem nenhum desses mecanismos (só recebe texto), então
+este módulo replica o essencial:
+
+  1. Memória do perfil: MEMORY.md + USER.md (arquivos pequenos — cabem
+     inteiros no prompt sem custo relevante).
+  2. Skills top-N por relevância: score das palavras-chave da query contra
+     name + description + category, corpo truncado (mesmo limite de 4000
+     chars que o scan do Hermes usa).
+
+Controle: `model.acp_context_pack` (config.yaml) ou env
+`HERMES_ANTIGRAVITY_ACP_CONTEXT_PACK`:
+  - "off" / "0" / "false"  → desligado (default)
+  - "auto" / "1" / "true"  → N=5 skills + memória
+  - número ("3", "10")     → N skills + memória
+
+Nunca levanta exceção fora do módulo: falha de pack NÃO pode quebrar um
+request (o kernel não pode depender da saúde da memória/skills do Hermes).
+"""
+from __future__ import annotations
+
+import logging
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_DEFAULT_MAX_SKILLS = 5
+_SKILL_BODY_LIMIT = 4000  # mesmo limite do scan do Hermes (tools/skills_tool.py)
+# Cache curto por (profile, query-hash) — o pack é recomputado no máximo
+# 1x por 60s por query, no processo em que o cliente roda.
+_CACHE_TTL_SECONDS = 60.0
+_cache: Dict[str, tuple[float, str]] = {}
+
+
+def is_context_pack_enabled() -> bool:
+    """Lê model.acp_context_pack (ou env). ''/None → off (opt-in)."""
+    env = os.getenv("HERMES_ANTIGRAVITY_ACP_CONTEXT_PACK", "").strip().lower()
+    if env:
+        return env not in {"0", "off", "false", "no"}
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        cfg = load_config_readonly()
+        m = cfg.get("model") or {}
+        v = m.get("acp_context_pack")
+        if v is None:
+            return False
+        if isinstance(v, bool):
+            return v
+        s = str(v).strip().lower()
+        return s not in {"", "0", "off", "false", "no"}
+    except Exception:
+        return False
+
+
+def max_skills() -> int:
+    """N de skills a injetar (auto → _DEFAULT_MAX_SKILLS; número → N)."""
+    env = os.getenv("HERMES_ANTIGRAVITY_ACP_CONTEXT_PACK", "").strip().lower()
+    raw = env
+    if not raw:
+        try:
+            from hermes_cli.config import load_config_readonly
+
+            cfg = load_config_readonly()
+            m = cfg.get("model") or {}
+            raw = str(m.get("acp_context_pack", "")).strip().lower()
+        except Exception:
+            raw = ""
+    if raw.isdigit():
+        return max(0, min(int(raw), 20))
+    return _DEFAULT_MAX_SKILLS
+
+
+def _profile_identity() -> str:
+    """Identidade do profile ativo para cache — HERMES_PROFILE ou HERMES_HOME."""
+    return (
+        os.getenv("HERMES_PROFILE", "")
+        or os.getenv("HERMES_HOME", "")
+        or os.path.expanduser("~/.hermes")
+    )
+
+
+def _memories_dir() -> Optional[Path]:
+    """Resolve o diretório de memórias do profile ativo (cascata)."""
+    profile = os.getenv("HERMES_PROFILE", "").strip()
+    home = os.getenv("HERMES_HOME", "").strip()
+    candidates = []
+    base = Path(os.path.expanduser("~/.hermes"))
+    if profile:
+        candidates.append(base / "profiles" / profile / "memories")
+    if home:
+        candidates.append(Path(home) / "memories")
+    candidates.append(base / "memories")
+    for c in candidates:
+        if c.is_dir():
+            return c
+    return None
+
+
+def _read_memory_file(d: Path, name: str) -> str:
+    p = d / name
+    try:
+        if p.is_file():
+            return p.read_text(encoding="utf-8", errors="replace").strip()
+    except Exception as e:
+        logger.debug("acp context: ler %s falhou: %s", name, e)
+    return ""
+
+
+def _query_from_messages(messages: List[Dict[str, Any]]) -> str:
+    """Última mensagem de role=user (a task atual)."""
+    for message in reversed(messages or []):
+        if not isinstance(message, dict):
+            continue
+        if str(message.get("role", "")).strip().lower() != "user":
+            continue
+        content = message.get("content")
+        if isinstance(content, str) and content.strip():
+            return content.strip()[:1000]
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, dict) and isinstance(block.get("text"), str):
+                    parts.append(block["text"])
+            if parts:
+                return " ".join(parts)[:1000]
+    return ""
+
+
+def _tokenize(text: str) -> set[str]:
+    return {w for w in re.findall(r"[a-z0-9]{3,}", text.lower()) if w not in _STOP}
+
+
+_STOP = {
+    "que", "para", "com", "uma", "pode", "isso", "essa", "este", "aqui",
+    "como", "mais", "mas", "por", "dos", "das", "the", "and", "for", "with",
+    "from", "this", "that", "you", "your", "have", "not", "are", "was",
+}
+
+# Budget máximo da perna externa (espelha _EXTERNAL_PREFETCH_TIMEOUT_S=8s
+# do MemoryManager, com folga para o import do plugin). O pack nunca pode
+# segurar o request ACP por causa de um backend de memória lento.
+_EXTERNAL_PREFETCH_BUDGET_S = 12.0
+_EXTERNAL_PREFETCH_CAP = 4000
+
+
+def _score_skill(query_tokens: set[str], skill: Dict[str, Any]) -> int:
+    haystack = " ".join(
+        str(skill.get(k, "")) for k in ("name", "description", "category")
+    ).lower()
+    words = set(re.findall(r"[a-z0-9]{3,}", haystack))
+    return len(query_tokens & words)
+
+
+def _find_skills() -> List[Dict[str, Any]]:
+    """Skills do profile vivo via scanner oficial do Hermes (filtrado por
+    plataforma e disabled), com fallback vazio em erro — nunca quebra o pack."""
+    try:
+        from tools.skills_tool import _find_all_skills
+
+        return _find_all_skills(skip_disabled=False)
+    except Exception as e:
+        logger.debug("acp context: scan de skills falhou: %s", e)
+        return []
+
+
+def _skill_body(skill: Dict[str, Any]) -> str:
+    """Corpo da skill (SKILL.md, truncado) — fallback vazio em erro."""
+    try:
+        from tools.skill_manager_tool import _find_skill
+
+        found = _find_skill(str(skill.get("name", "")))
+        if not found:
+            return ""
+        p = Path(found["path"]) / "SKILL.md"
+        if not p.is_file():
+            return ""
+        content = p.read_text(encoding="utf-8-sig", errors="replace")
+        # Corta frontmatter (--- ... ---) para o corpo começar no uso real.
+        if content.startswith("---"):
+            end = content.find("\n---", 3)
+            if end != -1:
+                content = content[end + 4 :]
+        return content.strip()[:_SKILL_BODY_LIMIT]
+    except Exception as e:
+        logger.debug("acp context: corpo da skill %s falhou: %s", skill.get("name"), e)
+        return ""
+
+
+def _external_prefetch(query: str) -> str:
+    """Prefetch do provider externo de memória (a mesma perna do nativo).
+
+    Espelha agent/turn_context.py: lê memory.provider do config, carrega
+    via plugins.memory.load_memory_provider, pula prompts triviais
+    (is_trivial_prompt) e chama prefetch(query) com budget limitado.
+    Retorna "" quando não há provider configurado (caso do profile
+    simpay hoje — só builtin, que já vai inteiro na seção MEMORY/USER),
+    em erro, ou em timeout. Nunca levanta.
+    """
+    if not query or not query.strip():
+        return ""
+    try:
+        from agent.memory_provider import is_trivial_prompt
+
+        if is_trivial_prompt(query):
+            return ""
+    except Exception:
+        pass
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        cfg = load_config_readonly()
+        mem_cfg = (cfg.get("memory") or {}) if isinstance(cfg, dict) else {}
+        provider_name = str(mem_cfg.get("provider", "") or "").strip()
+    except Exception as e:
+        logger.debug("acp context: ler memory.provider falhou: %s", e)
+        return ""
+    if not provider_name:
+        return ""
+    box: Dict[str, str] = {}
+
+    def _run() -> None:
+        try:
+            from plugins.memory import load_memory_provider
+
+            mp = load_memory_provider(provider_name)
+            if mp is None or not mp.is_available():
+                return
+            try:
+                mp.on_turn_start(0, query)
+            except Exception:
+                pass
+            box["value"] = mp.prefetch(query) or ""
+        except Exception as e:
+            logger.debug("acp context: prefetch externo falhou: %s", e)
+
+    import threading
+
+    t = threading.Thread(target=_run, daemon=True, name=f"acp-context-prefetch-{provider_name}")
+    t.start()
+    t.join(_EXTERNAL_PREFETCH_BUDGET_S)
+    if t.is_alive():
+        logger.warning(
+            "acp context: prefetch externo '%s' excedeu %.0fs (ignorado)",
+            provider_name, _EXTERNAL_PREFETCH_BUDGET_S,
+        )
+        return ""
+    return box.get("value", "").strip()[:_EXTERNAL_PREFETCH_CAP]
+
+
+def build_context_pack(messages: List[Dict[str, Any]]) -> str:
+    """Monta o bloco "Hermes context (memória + skills)" para o prompt ACP.
+
+    Retorna string vazia se desligado ou sem nada útil. Nunca levanta.
+    """
+    try:
+        if not is_context_pack_enabled():
+            return ""
+
+        query = _query_from_messages(messages)
+        profile = _profile_identity()
+        cache_key = f"{profile}\u0000{query}\u0000{max_skills()}"
+        now = time.monotonic()
+        cached = _cache.get(cache_key)
+        if cached and (now - cached[0]) < _CACHE_TTL_SECONDS:
+            return cached[1]
+
+        sections: List[str] = []
+
+        # 1) Memória do perfil (arquivos pequenos — inteiros)
+        mem_dir = _memories_dir()
+        if mem_dir:
+            memory = _read_memory_file(mem_dir, "MEMORY.md")
+            user = _read_memory_file(mem_dir, "USER.md")
+            if memory:
+                sections.append("MEMORY (notas persistentes do Hermes):\n" + memory[:6000])
+            if user:
+                sections.append("USER (perfil do usuário):\n" + user[:4000])
+
+        # 1b) Provider externo de memória (mesma perna do nativo). No
+        # profile simpay hoje retorna "" (só builtin) — sem custo.
+        try:
+            ext = _external_prefetch(query)
+        except Exception:
+            ext = ""
+        if ext:
+            sections.append("MEMORY PROVIDER (prefetch relevante à task):\n" + ext)
+
+        # 2) Skills top-N por relevância
+        n = max_skills()
+        if n > 0:
+            skills = _find_skills()
+            query_tokens = _tokenize(query) if query else set()
+            scored = [( _score_skill(query_tokens, s), s) for s in skills]
+            scored.sort(key=lambda pair: (pair[0], str(pair[1].get("name", ""))), reverse=True)
+            picked = [s for score, s in scored if score > 0][:n]
+            # Query vazia ou sem match: sem skills (evita ruído aleatório).
+            if picked:
+                parts = []
+                for s in picked:
+                    body = _skill_body(s)
+                    if body:
+                        parts.append(f"### {s.get('name')} ({s.get('category','')})\n{body}")
+                if parts:
+                    sections.append(
+                        "SKILLS HERMES (conhecimento de domínio — siga o procedimento "
+                        "quando a task casar com o tema):\n" + "\n\n".join(parts)
+                    )
+
+        if not sections:
+            _cache[cache_key] = (now, "")
+            return ""
+
+        pack = (
+            "HERMES CONTEXT (contexto persistente que o kernel normalmente não vê — "
+            "memória do usuário + skills de domínio). Use quando relevante para a task:\n\n"
+            + "\n\n".join(sections)
+        )
+        _cache[cache_key] = (now, pack)
+        # Só log com o tamanho — o conteúdo não (privacidade + ruído).
+        logger.info("Antigravity ACP context pack: %d chars, %d seções", len(pack), len(sections))
+        return pack
+    except Exception as e:  # nunca quebra o request
+        logger.warning("Antigravity ACP context pack falhou (ignorado): %s", e)
+        return ""
