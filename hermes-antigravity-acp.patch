+def _apply_kernel_progress(progress: dict[str, Any], parsed: dict[str, Any]) -> None:
+    """Fold one parsed stderr event into the shared progress dict.
+
+    Live trail: every NEW activity desc is also logged at info level so
+    agent.log (/dashboard logs) shows the kernel working in real time
+    (toolCall → stepUpdate → …), not just the final usage line. Both
+    call sites are already gated to the antigravity feed, so this never
+    fires for copilot-acp. Never raises.
+    """
+    now = time.monotonic()
+    progress["last_event_ts"] = now
+    desc = parsed.get("desc")
+    if desc:
+        try:
+            if desc != progress.get("last_desc"):
+                logger.info("Antigravity ACP kernel: %s", desc)
+        except Exception:
+            pass
+        progress["last_desc"] = desc
+        progress["last_desc_ts"] = now
+    if parsed.get("steps"):
+        progress["steps"] = progress.get("steps", 0) + 1
+    if parsed.get("tools"):
+        progress["tools"] = progress.get("tools", 0) + 1
+    usage = parsed.get("usage")
+    if isinstance(usage, dict):
+        for k in ("prompt", "completion", "cached"):
+            v = usage.get(k) or 0
+            if v > 0:
+                progress["usage"][k] = max(progress["usage"].get(k, 0), v)
+
+
+def _finalize_progress_usage(progress: dict[str, Any], prev_usage: dict[str, Any]) -> None:
+    """Compute per-prompt usage delta from cumulative usageUpdate values."""
+    delta = {"prompt": 0, "completion": 0, "cached": 0}
+    cur = progress.get("usage") or {}
+    for k in delta:
+        cur_v = int(cur.get(k) or 0)
+        prev_v = int(prev_usage.get(k) or 0)
+        delta[k] = max(0, cur_v - prev_v)
+    progress["usage_delta"] = delta
+
+
+def _log_kernel_usage(progress: dict[str, Any], session_id: str) -> None:
+    """Log the real kernel token counts (kills the `in=0 out=0` lie)."""
+    d = progress.get("usage_delta") or {}
+    if d.get("prompt") or d.get("completion"):
+        logger.info(
+            "Antigravity ACP kernel usage (session %s): in=%s out=%s cached=%s",
+            session_id, d.get("prompt", 0), d.get("completion", 0), d.get("cached", 0),
+        )
+
+
+def _progress_activity_summary(progress: dict[str, Any] | None) -> str:
+    """One-line activity summary for timeout/diagnostic messages."""
+    if not progress:
+        return ""
+    desc = progress.get("last_desc")
+    last_ts = progress.get("last_event_ts")
+    now = time.monotonic()
+    if desc or last_ts:
+        age = f" há {int(max(0, now - last_ts))}s" if last_ts else ""
+        return f"última atividade: {desc or 'evento'}{age}."
+    return ""
+
