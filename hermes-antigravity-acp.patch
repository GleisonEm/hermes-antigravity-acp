+class _PersistentACPSession:
+    def __init__(self, key: str, command: str, args: list[str], cwd: str, proc: Any, inbox: Any, stderr_tail: Any, out_thread: Any, err_thread: Any, session_id: str, progress: dict[str, Any] | None = None):
+        self.key = key
+        self.command = command
+        self.args = list(args)
+        self.cwd = cwd
+        self.proc = proc
+        self.inbox: queue.Queue = inbox
+        self.stderr_tail: deque = stderr_tail
+        self.out_thread = out_thread
+        self.err_thread = err_thread
+        self.session_id = session_id
+        self.next_id = 10  # initialize(1) + session/new(2) + optional set_config(3..) = 10 headroom
+        self.kernel_model_ids: set[str] = set()
+        self.last_model: str | None = None
+        self.last_mode: str | None = None
+        self.lock = threading.Lock()
+        self.created_at = time.monotonic()
+        # Kernel progress telemetry (stderr feed) — mutated by err_thread.
+        self.progress: dict[str, Any] = progress if progress is not None else _new_kernel_progress()
+        # Set by cancel_acp_keep_alive_sessions() (interrupt path). Every
+        # inbox wait loop in this module polls it each 0.1s iteration, so a
+        # user stop aborts within ~0.1s instead of running to the deadline
+        # while holding self.lock.
+        self.cancel_event = threading.Event()
+
+    def is_alive(self) -> bool:
+        try:
+            return self.proc.poll() is None
+        except Exception:
+            return False
+
+    def close(self) -> None:
+        try:
+            self.proc.terminate()
+            self.proc.wait(timeout=2)
+        except Exception:
+            try:
+                self.proc.kill()
+            except Exception:
+                pass
+
