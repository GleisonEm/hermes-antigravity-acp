+def _parse_kernel_stderr_line(line: str) -> dict[str, Any] | None:
+    """Parse one kernel stderr line → progress update (or None).
+
+    Returns {"desc": str|None, "usage": dict|None, "any": True}. Pure
+    function — unit-testable with real kernel log lines. Never raises.
+    """
+    if not isinstance(line, str) or "RAW WS MSG" not in line:
+        return None
+    m = re.search(r"RAW WS MSG:\s*(\{.*\})", line)
+    if not m:
+        return None
+    try:
+        msg = json.loads(m.group(1))
+    except Exception:
+        return None
+    if not isinstance(msg, dict) or not msg:
+        return None
+    result: dict[str, Any] = {"desc": None, "usage": None, "any": True}
+    kind, payload = next(iter(msg.items()))
+    try:
+        if kind == "toolCall" and isinstance(payload, dict):
+            name = str(payload.get("name") or "tool")
+            result["desc"] = f"{name}{_brief_tool_args(str(payload.get('argumentsJson') or ''))}"
+            result["tools"] = 1
+        elif kind == "stepUpdate" and isinstance(payload, dict):
+            idx = payload.get("stepIndex")
+            total = payload.get("totalSteps")
+            if isinstance(idx, int):
+                suffix = f"/{total}" if isinstance(total, int) else ""
+                result["desc"] = f"passo {idx + 1}{suffix}"
+            result["steps"] = 1
+        elif kind == "usageUpdate":
+            usage = payload.get("usage") if isinstance(payload, dict) else None
+            if not isinstance(usage, dict):
+                usage = payload
+            # The kernel wraps per-agent usage in an "agents" list; sum them.
+            agents = payload.get("agents") if isinstance(payload, dict) else None
+            if isinstance(agents, list) and agents:
+                summed = {"prompt": 0, "completion": 0, "cached": 0}
+                for entry in agents:
+                    if not isinstance(entry, dict):
+                        continue
+                    u = entry.get("usage") if isinstance(entry.get("usage"), dict) else entry
+                    if not isinstance(u, dict):
+                        continue
+
+                    def _u2(*keys: str) -> int:
+                        for k in keys:
+                            v = u.get(k) if isinstance(u, dict) else None
+                            if v is None:
+                                continue
+                            try:
+                                return int(v)
+                            except (TypeError, ValueError):
+                                continue
+                        return 0
+
+                    summed["prompt"] += _u2("promptTokenCount", "inputTokens")
+                    summed["completion"] += _u2("completionTokenCount", "outputTokens")
+                    summed["cached"] += _u2("cachedCacheReadTokenCount", "cachedInputTokens")
+                result["usage"] = summed
+            elif isinstance(usage, dict):
+                def _u(*keys: str) -> int:
+                    for k in keys:
+                        v = usage.get(k)
+                        if v is None:
+                            continue
+                        try:
+                            return int(v)
+                        except (TypeError, ValueError):
+                            continue
+                    return 0
+                result["usage"] = {
+                    "prompt": _u("promptTokenCount", "inputTokens"),
+                    "completion": _u("completionTokenCount", "outputTokens"),
+                    "cached": _u("cachedCacheReadTokenCount", "cachedInputTokens"),
+                }
+        elif kind == "policyDecisionRequest" and isinstance(payload, dict):
+            tool_args = payload.get("toolArgs") or {}
+            tname = str((tool_args.get("toolName") if isinstance(tool_args, dict) else None) or "ação")
+            result["desc"] = f"aguardando permissão: {tname}"
+        elif kind == "trajectoryStateUpdate":
+            state = str((payload.get("state") if isinstance(payload, dict) else None) or "")
+            if state and state != "STATE_RUNNING":
+                result["desc"] = f"estado: {state}"
+        # callHookRequest and anything else: activity only (no desc)
+    except Exception:
+        result["desc"] = None
+        result["usage"] = None
+    return result
+
