+def evict_acp_keep_alive_session(key: str, reason: str = "evict") -> None:
+    """Drop one keep-alive session so the next turn boots fresh.
+
+    Signals cancel first (in case the owner thread is still inside its
+    prompt loop), then closes the kernel process. Safe to call holding no
+    locks; never raises.
+    """
+    with _KEEP_ALIVE_REGISTRY_LOCK:
+        sess = _KEEP_ALIVE_REGISTRY.pop(key, None)
+    if sess is None:
+        return
+    try:
+        evt = getattr(sess, "cancel_event", None)
+        if evt is not None:
+            evt.set()
+    except Exception:
+        pass
+    try:
+        sess.close()
+    except Exception:
+        pass
+    logger.info("ACP keep-alive: evicted session (%s)", reason)
