+def _boot_timeout_seconds(requested: float | None) -> float:
+    """Cap the kernel-boot budget at _BOOT_TIMEOUT_SECONDS.
+
+    The prompt deadline (often 180-900s) is fine for generation, but boot
+    (initialize + session/new) answers in seconds when Google is healthy —
+    past 60s it is a stall, and the caller deserves a fast, diagnosable
+    error instead of a hung session.
+    """
+    try:
+        v = float(requested or 0)
+    except (TypeError, ValueError):
+        v = 0
+    if v <= 0:
+        return _BOOT_TIMEOUT_SECONDS
+    return min(v, _BOOT_TIMEOUT_SECONDS)
