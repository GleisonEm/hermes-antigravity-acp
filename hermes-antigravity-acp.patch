+def _model_flow_antigravity_acp(config, current_model=""):
+    """Google Antigravity ACP flow using the local ACP kernel."""
+    from hermes_cli.auth import (
+        PROVIDER_REGISTRY,
+        _prompt_model_selection,
+        _save_model_choice,
+        deactivate_provider,
+        get_external_process_provider_status,
+        resolve_external_process_provider_credentials,
+    )
+    from hermes_cli.config import clear_model_endpoint_credentials, load_config, save_config
+    from hermes_cli.models import _PROVIDER_MODELS
+
+    del config
+
+    provider_id = "antigravity-acp"
+    pconfig = PROVIDER_REGISTRY[provider_id]
+
+    status = get_external_process_provider_status(provider_id)
+    resolved_command = (
+        status.get("resolved_command") or status.get("command") or "agy_acp_server.par"
+    )
+    effective_base = status.get("base_url") or pconfig.inference_base_url
+
+    print("  Google Antigravity ACP delegates Hermes turns to the Antigravity")
+    print("  ACP kernel (agy_acp_server.par).")
+    print("  Hermes currently starts its own ACP subprocess for each request.")
+    print("  Hermes uses your selected model as a hint for the ACP session.")
+    print(f"  Command: {resolved_command}")
+    print(f"  Backend marker: {effective_base}")
+    print()
+
+    try:
+        creds = resolve_external_process_provider_credentials(provider_id)
+    except Exception as exc:
+        print(f"  ⚠ {exc}")
+        print(
+            "  Install it via the Zed Antigravity extension or set "
+            "HERMES_ANTIGRAVITY_ACP_COMMAND/AGY_ACP_COMMAND to its path."
+        )
+        return
+
+    effective_base = creds.get("base_url") or effective_base
+
+    model_list = list(_PROVIDER_MODELS.get("antigravity-acp", ["antigravity-acp"]))
+    if model_list:
+        selected = _prompt_model_selection(
+            model_list,
+            current_model=current_model or model_list[0],
+            confirm_provider=provider_id,
+            confirm_base_url=effective_base,
+        )
+    else:
+        try:
+            selected = input("Model name: ").strip()
+        except (KeyboardInterrupt, EOFError):
+            selected = None
+
+    if not selected:
+        print("No change.")
+        return
+
+    _save_model_choice(selected)
+
+    # Prompt for ACP session mode (Zed parity: default/auto_edit/yolo). This
+    # controls whether the kernel asks permission before edits/commands.
+    # Stored as model.acp_mode; the ACP client reads it (or
+    # HERMES_ANTIGRAVITY_ACP_MODE env) and sends session/set_config_option.
+    try:
+        current_mode = ""
+        try:
+            _cfg_tmp = load_config()
+            _m = _cfg_tmp.get("model") or {}
+            if isinstance(_m, dict):
+                current_mode = str(_m.get("acp_mode") or "").strip().lower()
+        except Exception:
+            pass
+        if current_mode not in {"default", "auto_edit", "yolo"}:
+            current_mode = "yolo" if not current_mode else current_mode
+        print()
+        print(f"  Current Antigravity mode: {current_mode or 'default'}")
+        print("  Modes: default (ask before every edit), auto_edit (auto edits, ask for commands), yolo (auto everything).")
+        try:
+            raw = input(f"  Antigravity mode [{current_mode}] (default/auto_edit/yolo, Enter to keep): ").strip().lower()
+        except (KeyboardInterrupt, EOFError):
+            raw = ""
+        chosen_mode = raw if raw in {"default", "auto_edit", "yolo"} else current_mode
+        if chosen_mode not in {"default", "auto_edit", "yolo"}:
+            chosen_mode = "default"
+    except Exception:
+        chosen_mode = None
+
+    cfg = load_config()
+    model = cfg.get("model")
+    if not isinstance(model, dict):
+        model = {"default": model} if model else {}
+        cfg["model"] = model
+    model["provider"] = provider_id
+    model["base_url"] = effective_base
+    model["api_mode"] = "chat_completions"
+    if chosen_mode in {"default", "auto_edit", "yolo"}:
+        model["acp_mode"] = chosen_mode
+    clear_model_endpoint_credentials(model, clear_api_mode=False)
+    save_config(cfg)
+    deactivate_provider()
+
+    print(f"Default model set to: {selected} (via {pconfig.name})")
+    if chosen_mode in {"default", "auto_edit", "yolo"}:
+        print(f"Antigravity mode set to: {chosen_mode} (model.acp_mode)")
+
+
