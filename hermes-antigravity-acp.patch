+            if isinstance(_m, dict):
+                current_pack = str(_m.get("acp_context_pack") or "").strip().lower()
+        except Exception:
+            pass
+        if current_pack not in {"auto", "off"}:
+            current_pack = "auto" if not current_pack else current_pack
+        print()
+        print(f"  Current Antigravity context pack: {current_pack or 'off'}")
+        print("  auto: attach the user's memory + top relevant Hermes skills to the kernel prompt (like native providers).")
+        print("  off: kernel sees only the conversation transcript.")
+        try:
+            raw_pack = input(f"  Antigravity context pack [{current_pack}] (auto/off, Enter to keep): ").strip().lower()
