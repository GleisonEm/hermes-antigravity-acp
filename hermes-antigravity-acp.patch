+def _brief_tool_args(arguments_json: str, limit: int = 40) -> str:
+    """Tiny human-readable hint from a tool's arguments JSON (path basename).
+
+    E.g. codegraph_explore {"Arguments":{"projectPath":"/Users/.../uniplus-api"}}
+    → " (uniplus-api)". Never raises; returns "" on anything unexpected.
+    """
+    try:
+        args = json.loads(arguments_json or "{}")
+    except Exception:
+        return ""
+    for _ in range(2):  # unwrap one {"Arguments": {...}} nesting level
+        if isinstance(args, dict) and len(args) == 1:
+            inner = next(iter(args.values()))
+            if isinstance(inner, dict):
+                args = inner
+                continue
+        break
+    if not isinstance(args, dict):
+        return ""
+    for key in ("AbsolutePath", "filePath", "path", "projectPath", "file_name", "filename"):
+        val = args.get(key)
+        if isinstance(val, str) and val.strip():
+            name = os.path.basename(val.strip().rstrip("/")) or val.strip()
+            return f" ({name[:limit]})"
+    if isinstance(args.get("content"), str) and args["content"].strip():
+        return " (write)"
+    return ""
+
