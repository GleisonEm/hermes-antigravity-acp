+def _default_antigravity_acp_command() -> str:
+    """Locate the Antigravity ACP kernel (agy_acp_server.par).
+
+    Search order:
+      1. Zed's Antigravity extension registry copy (newest versioned dir) —
+         preferred because the kernel finds its ``localharness_external``
+         sandbox binary relative to its REAL launch path; launching through
+         a symlink (e.g. ~/.local/bin/agy_acp_server.par) makes session/new
+         fail with "Could not find default localharness binary".
+      2. ~/.local/bin/agy_acp_server.par  (stable user location / symlink)
+    """
+    candidates: list[str] = []
+    try:
+        zed_registry = (
+            Path.home()
+            / "Library/Application Support/Zed/external_agents/registry/antigravity-acp"
+        )
+        if zed_registry.is_dir():
+            for child in sorted(zed_registry.iterdir(), reverse=True):
+                par = child / "agy_acp_server.par"
+                if par.is_file():
+                    candidates.append(str(par))
+                    break
+    except Exception:
+        pass
+    candidates.append(os.path.expanduser("~/.local/bin/agy_acp_server.par"))
+    for candidate in candidates:
+        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return candidates[0] if candidates else "agy_acp_server.par"
+
