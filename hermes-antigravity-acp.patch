+# Persistent ACP sessions — one kernel process + sessionId lives across
+# multiple Hermes turns (like Zed). Keyed by (command, args, cwd) so
+# concurrent Hermes sessions with different cwds don't share a kernel.
+_KEEP_ALIVE_REGISTRY: dict[str, Any] = {}
+_KEEP_ALIVE_REGISTRY_LOCK = threading.Lock()
+
+
+class _PersistentACPSession:
+    def __init__(self, key: str, command: str, args: list[str], cwd: str, proc: Any, inbox: Any, stderr_tail: Any, out_thread: Any, err_thread: Any, session_id: str):
+        self.key = key
+        self.command = command
+        self.args = list(args)
+        self.cwd = cwd
+        self.proc = proc
+        self.inbox: queue.Queue = inbox
+        self.stderr_tail: deque = stderr_tail
+        self.out_thread = out_thread
+        self.err_thread = err_thread
+        self.session_id = session_id
+        self.next_id = 10  # initialize(1) + session/new(2) + optional set_config(3..) = 10 headroom
+        self.kernel_model_ids: set[str] = set()
+        self.last_model: str | None = None
+        self.last_mode: str | None = None
+        self.lock = threading.Lock()
+        self.created_at = time.monotonic()
+
+    def is_alive(self) -> bool:
+        try:
+            return self.proc.poll() is None
+        except Exception:
+            return False
+
+    def close(self) -> None:
+        try:
+            self.proc.terminate()
+            self.proc.wait(timeout=2)
+        except Exception:
+            try:
+                self.proc.kill()
+            except Exception:
+                pass
+
+
+def _keep_alive_key(command: str, args: list[str], cwd: str) -> str:
+    return f"{command}\x00{','.join(args)}\x00{cwd}"
+
