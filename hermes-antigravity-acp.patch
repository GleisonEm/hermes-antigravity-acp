+# Persistent ACP sessions — one kernel process + sessionId lives across
+# multiple Hermes turns (like Zed). Keyed by (command, args, cwd) so
+# concurrent Hermes sessions with different cwds don't share a kernel.
+_KEEP_ALIVE_REGISTRY: dict[str, Any] = {}
+_KEEP_ALIVE_REGISTRY_LOCK = threading.Lock()
