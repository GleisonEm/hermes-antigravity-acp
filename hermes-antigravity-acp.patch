+def _is_keep_alive_enabled() -> bool:
+    """Whether to keep the ACP kernel alive across turns (Zed-like)."""
+    env = os.getenv("HERMES_ANTIGRAVITY_ACP_KEEP_ALIVE", "").strip().lower()
+    if env:
+        return env in {"1", "true", "yes", "on"}
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        cfg = load_config_readonly()
+        m = cfg.get("model") or {}
+        if isinstance(m, dict):
+            v = m.get("acp_keep_alive")
+            if isinstance(v, bool):
+                return v
+            if isinstance(v, str):
+                return v.strip().lower() in {"1", "true", "yes", "on"}
+            if isinstance(v, int):
